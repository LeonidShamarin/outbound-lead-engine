# Local Postgres from docker-compose.yml. In the cloud this is the Neon connection string.
DATABASE_URL=postgresql://leadengine:leadengine@localhost:5433/leadengine

# --- LLM provider fallback chain ---------------------------------------------
# Order: current provider (Groq) first, then the ai-keys.env four, then the
# last-priority keys. Set as many as you have; the app skips the unset ones and
# falls through on failure. Keys live in env only, never in the repo.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=            # AIza... or the new AQ.Ab8RN6... AI-Studio key
OPENAI_API_KEY=sk-proj-...
XAI_API_KEY=xai-...
# Tried last (from ключі2.txt):
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY_2=
